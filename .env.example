# Enterprise Hierarchical Multi-Agent RAG System
# .env.example — Copy to .env and fill in your keys

# ── LLM Provider (optional — system works without this in mock mode) ──
GOOGLE_API_KEY=your_google_api_key_here

# ── Optional: Pinecone (production vector store) ──
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=enterprise-rag

# ── Optional: LangSmith tracing ──
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=enterprise-rag-agent

# ── FastAPI server ──
API_HOST=0.0.0.0
API_PORT=8000
